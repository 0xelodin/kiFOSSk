<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="kiFOSSk Setup"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:gravity="center"
            android:layout_marginBottom="32dp"/>

        <!-- Dashboard URL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dashboard URL"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/editTextUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="http://192.168.1.100:3001"
            android:inputType="textUri"
            android:autofillHints="url"
            android:minHeight="48dp"/>

        <!-- Keep Screen On -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Keep Screen On"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"/>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchScreenOn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Prevent screen timeout while charging"/>

        <!-- Screen Schedule -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Screen Schedule"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"/>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchSchedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="Use schedule (replaces Keep Screen On)"/>

        <TextView
            android:id="@+id/textScheduleHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Keep on: the screen stays on in these periods; outside them it goes dark after the system screen timeout. Wake: the screen turns on by itself. Dim: lowers the brightness of the dashboard."
            android:textSize="12sp"
            android:textColor="?android:attr/textColorHint"
            android:layout_marginTop="4dp"/>

        <!-- Rows are added by SettingsActivity.buildScheduleRows() -->
        <LinearLayout
            android:id="@+id/layoutSchedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

        <!-- Orientation -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Orientation"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"/>

        <Spinner
            android:id="@+id/spinnerOrientation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:entries="@array/orientation_options"/>

		<!-- Auto-Refresh -->
		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="Auto-Refresh"
			android:textSize="16sp"
			android:textColor="?android:attr/textColorSecondary"
			android:layout_marginTop="24dp"
			android:layout_marginBottom="8dp"/>

		<androidx.appcompat.widget.SwitchCompat
			android:id="@+id/switchAutoRefresh"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:checked="false"
			android:text="Enable automatic page reload"
			android:layout_marginBottom="8dp"/>

		<TextView
			android:id="@+id/textRefreshIntervalLabel"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="Refresh Interval"
			android:textSize="16sp"
			android:textColor="?android:attr/textColorSecondary"
			android:layout_marginTop="8dp"
			android:layout_marginBottom="8dp"/>

		<Spinner
			android:id="@+id/spinnerRefreshInterval"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:minHeight="48dp"
			android:entries="@array/refresh_intervals"
			android:enabled="false"/>
		
		<TextView
			android:id="@+id/textLauncherStatus"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="Launcher: Not Set"
			android:textSize="14sp"
			android:textColor="#ff6b6b"
			android:layout_marginBottom="8dp"
			android:gravity="center"/>
		
		<Button
			android:id="@+id/buttonSetLauncher"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="Set as Home Launcher"
			android:backgroundTint="#6d4aff"
			android:textColor="#ffffff"
			android:padding="16dp"
			android:layout_marginBottom="24dp"/>

        <!-- Save Button -->
        <Button
            android:id="@+id/buttonSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save &amp; Launch"
            android:minHeight="48dp"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="24dp"/>

        <!-- Helper Text -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tip: Long-press anywhere to reopen settings"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorHint"
            android:gravity="center"
            android:layout_marginTop="16dp"/>

    </LinearLayout>
</ScrollView>